<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD3</title>
    <script language="JavaSCript">  
        function Homnay() {
            var d = new Date()
            var month = d.getMonth() + 1;
            var year = d.getFullYear()
            alert("Hom nay la ngay" + d.getDate() + "thang" + month + "nam" + year);
        }
        
    </script>
</head>
<body>
    <form name="form1">
        <input type="Button" value="Ngay hom nay" onclick="Homnay();"/>
    
    </form>
</body>
</html>
